# Environment for the test suite. Committed on purpose.
#
# app/database.py and app/templates_config.py call load_dotenv() at import time,
# which reads .env. Without this file the suite runs against whatever happens to be
# configured on the machine, so it passes in CI (no .env there, every value falls to
# its default) and fails locally with 26 errors. conftest.py loads this file with
# override=True before importing the app, so both agree.
#
# Add a variable here whenever application behaviour depends on it. If a test asserts
# behaviour that only holds for a particular value, that value belongs in this file.

# Empty means _verify_turnstile (app/routes/auth.py:59) skips verification. A test
# client cannot produce a real Turnstile token, so registration tests need this unset.
# Tests that cover the verification path itself should set a fake secret and mock the
# Cloudflare call rather than removing this.
TURNSTILE_SECRET_KEY=

# Tests assert canonical and og: URLs in this form (tests/test_seo.py).
BASE_URL=https://scroll.press

# Never point the suite at a real database. Most tests use the in-memory SQLite engine
# built in conftest, but anything reaching app.database directly (the /health endpoint,
# for instance) uses this one. This deliberately points at a port nothing listens on,
# so the failure is an immediate connection refusal rather than an auth attempt against
# whatever else happens to be running locally.
#
# CI sets its own DATABASE_URL for the postgres service in .github/workflows/ci.yml, and
# conftest preserves it, so the three tests that need a live database pass there and are
# the only ones that fail on a machine with no database running.
DATABASE_URL=postgresql+asyncpg://press_test:press_test@127.0.0.1:59999/press_test
